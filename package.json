{
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -c ./shared/styles/tailwind.config.cjs -i ./shared/styles/tailwind.css -o ./shared/assets/tailwind.css --minify",
    "build:site": "npm run build:css && node shared/build/site.cjs",
    "d1:seed": "node cloudflare/scripts/build-seed.cjs",
    "d1:migrate:local": "wrangler d1 migrations apply cassianslog-data --local",
    "d1:migrate:remote": "wrangler d1 migrations apply cassianslog-data --remote",
    "d1:seed:local": "npm run d1:seed && wrangler d1 execute cassianslog-data --local --file=.cloudflare/d1-seed.sql",
    "d1:seed:remote": "npm run d1:seed && wrangler d1 execute cassianslog-data --remote --file=.cloudflare/d1-seed.sql",
    "build:compendium": "node compendium/scripts/build.cjs",
    "build:compendium-cleanup-sql": "node compendium/scripts/build-d1-cleanup.cjs",
    "clean:compendium": "node compendium/scripts/clean-data.cjs",
    "import:wiki": "node wiki/scripts/import.cjs",
    "test:browser": "node shared/tests/browser-smoke.test.cjs",
    "test": "node shared/tests/run.cjs"
  },
  "devDependencies": {
    "fast-xml-parser": "^5.7.0",
    "tailwindcss": "^3.4.17",
    "wrangler": "^4.122.0",
    "yjs": "^13.6.31"
  }
}
